# =================================================================
# Document RAG System - Environment Configuration Template
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Update the values below with your credentials.
# Note: Never commit your actual .env file with real credentials!
# =================================================================

# -----------------------------------------------------------------
# Database Configuration (PostgreSQL with pgvector)
# -----------------------------------------------------------------
DB_PASSWORD=postgres_password_here

# -----------------------------------------------------------------
# Primary AI Model: Google Gemini Cloud API
# The RAG system prefers Gemini first for fast, accurate answers.
# Get a free key at: https://aistudio.google.com/
# -----------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-3.8-flash

# -----------------------------------------------------------------
# Fallback AI Model: Local Ollama (Qwen)
# If your Gemini token limit or quota is exhausted, the system
# automatically shifts to Qwen without stopping or throwing errors!
# -----------------------------------------------------------------
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
