# =================================================================
# Document RAG System - Environment Configuration Template
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Update the values below with your credentials and preferences.
# Note: Never commit your actual .env file with real credentials!
# =================================================================

# -----------------------------------------------------------------
# Database Configuration (PostgreSQL with pgvector)
# -----------------------------------------------------------------
DB_PASSWORD=postgres_password_here

# -----------------------------------------------------------------
# AI Provider Selection: 'ollama' or 'gemini'
# -----------------------------------------------------------------
AI_PROVIDER=ollama

# -----------------------------------------------------------------
# Ollama Configuration (Used when AI_PROVIDER=ollama)
# - If Ollama runs on host machine (Windows/Mac): http://host.docker.internal:11434
# - If Ollama runs in Docker network:          http://ollama:11434
# -----------------------------------------------------------------
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# -----------------------------------------------------------------
# Google Gemini Configuration (Used when AI_PROVIDER=gemini)
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
# -----------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-3.8-flash
